# InfraPulse local development example.
# Copy to .env for local use only. Keep real secrets out of Git.

INFRAPULSE_DB_URL=jdbc:postgresql://localhost:5432/infrapulse
INFRAPULSE_DB_USERNAME=infrapulse
INFRAPULSE_DB_PASSWORD=replace_with_local_dev_password
INFRAPULSE_DB_DRIVER=org.postgresql.Driver

INFRAPULSE_REDIS_HOST=localhost
INFRAPULSE_REDIS_PORT=6379

INFRAPULSE_TEST_DB_URL=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1
INFRAPULSE_TEST_DB_USERNAME=sa
INFRAPULSE_TEST_DB_PASSWORD=
INFRAPULSE_TEST_DB_DRIVER=org.h2.Driver
